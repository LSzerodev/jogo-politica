# ------------------------------------------------------------------
# Quase tudo se configura pelo PAINEL (http://127.0.0.1:9595).
# O que voce salva no painel fica em server/data/settings.json.
# ------------------------------------------------------------------

# Porta do servidor (painel em http://127.0.0.1:PORT, jogo para o OBS em /jogo)
PORT=9595

# Usuario do TikTok (sem @) que aparece preenchido no painel na primeira vez
TIKTOK_USERNAME=

# Proxy opcional para o TikTok (ex: socks5h://127.0.0.1:9050 para Tor)
TIKTOK_PROXY=
